{
  "version": 2,
  "builds": [
    {
      "src": "backend/package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["shared/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/$1"
    }
  ],
  "installCommand": "npm install && npm run build:shared",
  "buildCommand": "npm run build"
}
