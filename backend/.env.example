# Environment
NODE_ENV=development

# Server
PORT=3001

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# JWT Secret (REQUIRED in production)
JWT_SECRET=your-secure-random-secret-key-here

# Email Configuration (Production only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@razmenavrtica.rs

# Note: In development mode (NODE_ENV !== 'production'):
# - Email confirmation is automatically bypassed
# - Confirmation emails are logged to console instead of being sent
# - Users can login immediately after registration
