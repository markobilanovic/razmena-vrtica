# Environment
NODE_ENV=development

# Server
PORT=3001

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=admin
DB_PASSWORD=password
DB_NAME=razmena_vrtica

# JWT Secret (REQUIRED in production)
JWT_SECRET=your-secure-random-secret-key-here

# Mailgun Configuration (Production only)
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org
MAILGUN_FROM=Your App Name <postmaster@your-mailgun-domain.mailgun.org>
# For EU domains, uncomment:
# MAILGUN_EU=true

# Note: In development mode (NODE_ENV !== 'production'):
# - Email confirmation is automatically bypassed
# - Confirmation emails are logged to console instead of being sent
# - Users can login immediately after registration
