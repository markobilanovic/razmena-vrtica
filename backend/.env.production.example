# Production Environment Configuration
NODE_ENV=production

# Frontend URL (production domain)
FRONTEND_URL=https://your-domain.com

# JWT Secret (MUST be changed in production)
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Supabase Database Configuration
# Get this from: Supabase Dashboard > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Alternative: Individual connection parameters (if not using DATABASE_URL)
# DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-supabase-password
# DB_NAME=postgres
# DB_SSL=true

# Note: SUPABASE_PROJECT_URL and SUPABASE_ANON_KEY are only needed if using
# Supabase client features (auth, storage, real-time). Currently not used.

# Email Provider Configuration
# Choose between 'smtp' (Gmail/Nodemailer) or 'resend'
# If not set, defaults to 'smtp'
EMAIL_PROVIDER=smtp

# SMTP Configuration (for Gmail or other SMTP providers)
# Required when EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false  # true for port 465, false for other ports (587, 25)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password  # Generate at: https://myaccount.google.com/apppasswords

# Resend Configuration (alternative to SMTP)
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_production_api_key

# Email From Address (optional, has sensible defaults based on provider)
EMAIL_FROM=Razmena Vrtica <noreply@your-domain.com>

# Additional Production Settings
LOG_LEVEL=info
CORS_ORIGIN=https://your-domain.com