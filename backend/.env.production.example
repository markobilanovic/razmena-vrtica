# Production Environment Configuration
NODE_ENV=production

# Frontend URL (production domain)
FRONTEND_URL=https://your-domain.com

# JWT Secret (MUST be changed in production)
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Database (Managed PostgreSQL Service)
# Option 1: Individual connection parameters
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_USERNAME=your-db-user
DB_PASSWORD=your-secure-db-password
DB_NAME=razmena_vrtica

# Option 2: Connection string (alternative to above)
# DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# SSL Configuration (recommended for production)
DB_SSL=true

# Mailgun Configuration (Production)
MAILGUN_API_KEY=your-production-mailgun-api-key
MAILGUN_DOMAIN=your-verified-domain.com
MAILGUN_FROM=Razmena Vrtica <noreply@your-domain.com>
# For EU domains:
MAILGUN_EU=true

# Additional Production Settings
LOG_LEVEL=info
CORS_ORIGIN=https://your-domain.com