{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:shared && npx nest build",
    "build:shared": "cd ../shared && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:run": "ts-node -r tsconfig-paths/register src/seeds/run-seed.ts",
    "seed:prod": "NODE_ENV=production ts-node -r tsconfig-paths/register src/seeds/run-seed.ts",
    "seed:production": "NODE_ENV=production ts-node -r tsconfig-paths/register src/seeds/run-production-seed.ts",
    "migrate:age-groups": "ts-node -r tsconfig-paths/register src/scripts/update-child-age-groups.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "NODE_ENV=production npm run typeorm migration:run -- -d src/data-source.ts",
    "migration:revert": "NODE_ENV=production npm run typeorm migration:revert -- -d src/data-source.ts",
    "test:resend": "ts-node test-resend.ts",
    "test:email": "ts-node -r tsconfig-paths/register test-email-service.ts",
    "test:supabase": "ts-node -r tsconfig-paths/register test-supabase-connection.ts",
    "create-prod-db": "ts-node -r tsconfig-paths/register src/scripts/create-production-db.ts",
    "generate-schema": "ts-node -r tsconfig-paths/register src/scripts/generate-production-schema.ts",
    "generate-supabase-schema": "ts-node -r tsconfig-paths/register src/scripts/generate-supabase-schema.ts",
    "generate-migration-sql": "ts-node -r tsconfig-paths/register src/scripts/generate-migration-sql.ts",
    "compare-schemas": "ts-node -r tsconfig-paths/register src/scripts/compare-schemas.ts",
    "deploy-supabase": "ts-node -r tsconfig-paths/register src/scripts/deploy-to-supabase.ts"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@repo/shared": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.6.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}